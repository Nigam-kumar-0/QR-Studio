rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // QR Codes Collection
    match /qr_codes/{qrId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Scan Events (for tracking analytics and dynamic redirects)
    match /scan_events/{eventId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
  }
}
